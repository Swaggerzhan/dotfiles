#!/usr/bin/env sh

#
# for this to work you must configure sudo such that
# it will be able to run the command without password
# see this wiki page for information:
#  - https://github.com/koekeishiya/yabai/wiki/Installing-yabai-(latest-release)#configure-scripting-addition
#
yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"
sudo yabai --load-sa

# global settings
yabai -m config                                 \
    external_bar                 off:40:0       \
    menubar_opacity              0.8            \
    mouse_follows_focus          off            \
    focus_follows_mouse          off            \
    display_arrangement_order    default        \
    window_origin_display        default        \
    window_placement             second_child   \
    window_insertion_point       focused        \
    window_zoom_persist          on             \
    window_shadow                on             \
    window_animation_duration    0.0            \
    window_animation_easing      ease_out_circ  \
    window_opacity_duration      0.0            \
    active_window_opacity        0.95            \
    normal_window_opacity        0.95           \
    window_opacity               off             \
    insert_feedback_color        0xffd75f5f     \
    split_ratio                  0.50           \
    split_type                   auto           \
    auto_balance                 off            \
    top_padding                  12             \
    bottom_padding               12             \
    left_padding                 12             \
    right_padding                12             \
    window_gap                   06             \
    layout                       bsp            \
    mouse_modifier               fn             \
    mouse_action1                move           \
    mouse_action2                resize         \
    mouse_drop_action            swap

yabai -m config external_bar all:$(sketchybar --query bar | jq .height):0
yabai -m config --space 1 layout stack

# floating window
#yabai -m rule --add app="^System Settings$" manage=off layer=normal
#yabai -m rule --add app="^Activity Monitor$" manage=off layer=normal
#yabai -m rule --add app="^NetEaseMusic$" manage=off layer=normal
yabai -m rule --add app="System Settings" manage=off
yabai -m rule --add app="Activity Monitor" manage=off
yabai -m rule --add app="NetEaseMusic" manage=off
yabai -m rule --add app="Finder" manage=off
#yabai -m rule --add app="iTerm2" manage=off
yabai -m rule --add app="EuDic" manage=off
yabai -m rule --add app="GLKVM" manage=off
yabai -m rule --add app="哔哩哔哩" manage=off
yabai -m rule --add app="WeChat" title="Photos and Videos" manage=off
yabai -m rule --add app="QQ" title="图片查看器" manage=off
yabai -m rule --add app=".*" sub-layer=normal
yabai -m rule --apply

echo "yabai configuration loaded.."
